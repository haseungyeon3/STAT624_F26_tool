# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=stat1234
POSTGRES_DB=sqlda

# PGAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=stat1234

# MongoDB root administrator
MONGO_INITDB_ROOT_USERNAME=mongouser
MONGO_INITDB_ROOT_PASSWORD=stat1234
 

# Your Express/Python connection
DATABASE_URI=mongodb://mongouser:stat1234@mongo:27017/?authSource=admin

# mongo-express web login
MONGOEXPRESS_LOGIN=admin
MONGOEXPRESS_PASSWORD=stat1234